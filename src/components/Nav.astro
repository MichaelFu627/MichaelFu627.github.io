---
const links = [
  { label: 'Home', href: '/#about', anchor: 'about' },
  { label: 'Projects', href: '/#projects', anchor: 'projects' },
  { label: 'Publications', href: '/#publications', anchor: 'publications' },
  { label: 'Blog', href: '/blog', anchor: '' },
];
---
<nav class="sticky top-0 z-40 border-b border-line bg-white/80 backdrop-blur">
  <div class="mx-auto max-w-content px-7 h-16 flex items-center justify-between">
    <a href="/#about" class="inline-flex items-baseline gap-2 text-ink hover:text-blue transition-colors" aria-label="Xianglong Fu home">
      <span class="font-sign text-[25px] leading-none tracking-normal">付相龙</span>
      <span class="hidden sm:inline font-mono text-[11px] text-muted">xianglong.dev</span>
    </a>

    <div class="hidden sm:flex gap-7">
      {links.map((l) => (
        <a href={l.href} data-anchor={l.anchor} class="navlink">{l.label}</a>
      ))}
    </div>

    <button id="menu-btn" class="sm:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-ink hover:text-blue hover:bg-blue-soft transition-colors" aria-label="Toggle menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="w-5 h-5"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
  </div>

  <div id="mobile-menu" class="sm:hidden hidden border-t border-line bg-white">
    {links.map((l) => (
      <a href={l.href} class="navlink block px-7 py-3 border-b border-line last:border-0">{l.label}</a>
    ))}
  </div>
</nav>

<script>
  // Mobile menu toggle.
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));
  }

  // Scrollspy: highlight the nav link for the section currently in view.
  const navLinks = Array.from(document.querySelectorAll('a[data-anchor]'));
  const sections = Array.from(document.querySelectorAll('main section[id]'));
  if (location.pathname.startsWith('/blog')) {
    const blog = navLinks.find((a) => a.getAttribute('href') === '/blog');
    if (blog) blog.classList.add('active');
  } else if (sections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navLinks.forEach((a) => a.classList.toggle('active', a.dataset.anchor === entry.target.id));
        }
      });
    }, { rootMargin: '-30% 0px -60% 0px' });
    sections.forEach((s) => observer.observe(s));
  }
</script>
